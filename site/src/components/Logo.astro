---
/** The site mark: a planet with a tilted orbit and one satellite. Inherits currentColor. */
type Props = { class?: string };
const { class: className } = Astro.props;
---

<svg viewBox="0 0 24 24" fill="none" aria-hidden="true" class={className}>
  <circle cx="12" cy="12" r="4.25" fill="currentColor"></circle>
  <ellipse cx="12" cy="12" rx="10.25" ry="4.5" transform="rotate(-24 12 12)" stroke="currentColor" stroke-width="1.5" opacity="0.45"></ellipse>
  <circle cx="20.4" cy="7.6" r="1.6" fill="var(--accent)"></circle>
</svg>
